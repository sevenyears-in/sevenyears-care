<resources>
    <style name="Theme.SevenYears" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorAccent">@color/brand_pink</item>
    </style>

    <!-- Splash screen while the app starts -->
    <style name="Theme.SevenYears.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SevenYears</item>
    </style>
</resources>
